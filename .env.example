# Copy to ".env" in the project root (same folder as package.json).
# Do not put .env in public/, src/, or dist/. Vite loads env files from the project root.
# Never commit .env. Only VITE_ names are exposed to the browser.
# Do not put API keys, the Resend key, or the server notify secret in a VITE_ variable.

# --- Site (browser) ---
# Canonical origin for SEO, Open Graph, sitemap, and route meta.
# Optional. Empty falls back to https://www.ifranchise.in in app code and SEO scripts.
VITE_SITE_URL=https://www.example.com

# --- Google Apps Script (browser) ---
# Web App /exec URL that receives every form submission.
# Required for live forms. Production build fails if this and public/forms-endpoint.json are both empty.
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# --- Google Search Console (browser) ---
# Public HTML verification token. Written to a google-site-verification meta tag when set.
# Optional. There is no Bing verification variable in this codebase.
VITE_GOOGLE_SITE_VERIFICATION=your_search_console_token

# --- Analytics (browser) ---
# Optional. Empty uses the container and measurement IDs already fallback-coded in src/lib/analytics/gtm.js.
# GTM loads only after analytics consent. The measurement ID is sent with page_view events for the GTM tag.
VITE_GTM_CONTAINER_ID=GTM-XXXXXXX
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Lead email notifications, server only (Vercel) ---
# npm run dev does not serve /api/notify-lead. Set the real values in Vercel.
# RESEND_API_KEY and LEAD_NOTIFY_SECRET are server-only. Never use a VITE_ name.
# Apps Script Properties must also contain LEAD_NOTIFY_URL and the same LEAD_NOTIFY_SECRET.
RESEND_API_KEY=your_resend_api_key
LEAD_NOTIFICATION_TO=contact@example.com
LEAD_NOTIFICATION_FROM=sender@example.com
LEAD_NOTIFY_SECRET=replace-with-a-long-random-value
# Optional. Not used to authenticate the notify API.
LEAD_NOTIFY_ALLOWED_ORIGINS=
# Optional. Career applications only. Empty uses hr@ifranchise.in.
LEAD_NOTIFICATION_TO_CAREERS=hr@example.com

# --- Local scripts (not used by the website) ---
# Optional base URL for scripts/verify-lead-notify.mjs. Empty uses http://localhost:3000.
# Sitemap scripts also accept SITE_URL as a fallback alias for VITE_SITE_URL. Prefer VITE_SITE_URL.
NOTIFY_BASE_URL=http://localhost:3000
